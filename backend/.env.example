# Required — sign with: openssl rand -hex 32
MERQATO_SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# SQLite database (use an absolute path for persistent storage)
MERQATO_DATABASE_URL=sqlite:////data/merqato/merqato.db

# Document storage root (use an absolute path for persistent storage)
MERQATO_STORAGE_ROOT=/data/merqato/storage

# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGINS=https://your-app.vercel.app
